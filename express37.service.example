[Unit]
Description=Express 37 Telegram signals
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=express37
WorkingDirectory=/opt/express37/app
ExecStart=/opt/express37/.venv/bin/python /opt/express37/app/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
